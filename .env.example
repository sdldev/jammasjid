# Secret penanda tangan cookie sesi admin. WAJIB diganti:
#   openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string

# Password admin awal (login: user "admin", password = nilai ini).
# Login DITOLAK selama password masih "admin1234". Setelah instalasi: masuk
# ke admin → "Ganti password", atau ubah nilai ini lalu restart server.
ADMIN_PASS=admin1234

# Local server port (optional, default 11111)
PORT=11111

# --- Tailscale (opsional, remote SSH/admin) ---------------------------------
# Email pemilik tailnet (dipakai sebagai tagOwners saat membangun ACL).
# Diisi otomatis oleh install.sh (--tailscale-email).
#TAILSCALE_OWNER=anda@gmail.com

# Otomatisasi ACL dari panel admin. Gunakan OAuth client — TIDAK kedaluwarsa,
# cocok untuk perangkat tahunan. Buat di:
#   https://login.tailscale.com/admin/settings/oauth (scope: ACL)
# Hindari TS_API_KEY (API key pribadi) — kedaluwarsa maksimal 90 hari.
#TS_CLIENT_ID=
#TS_CLIENT_SECRET=
