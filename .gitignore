# Data runtime (ditulis aplikasi saat berjalan) — jangan pernah di-commit.
# db/database.example.json adalah template; server membuat db/database.json
# sendiri dari DEFAULT_DB bila file belum ada.
/db/*.json
!/db/database.example.json
